# Copy to deployment/.env.production; replace survey.example.com with your domain.
DATABASE_NAME=survey_production
DATABASE_USER=survey
DATABASE_PASSWORD=
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=survey.example.com,localhost,127.0.0.1,api
CORS_ORIGINS=https://survey.example.com
CSRF_TRUSTED_ORIGINS=https://survey.example.com
SURVEY_WEB_URL=https://survey.example.com
# Blank compiles same-origin browser requests; build again after changing it.
NEXT_PUBLIC_API_URL=
DOMAIN=survey.example.com
ACME_EMAIL=
RELEASE_TAG=production-001
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=true


