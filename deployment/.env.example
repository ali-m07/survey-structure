# Merge these server-only AI settings into your deployment environment file.
# Download the model on the Ollama host first: ollama pull qwen3:1.7b
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3:1.7b
AI_TIMEOUT=90
AI_API_KEY=
# For an OpenAI-compatible server use AI_PROVIDER=openai, its /v1 base URL,
# a supported model, and a real AI_API_KEY. Never use NEXT_PUBLIC_ for secrets.
# Set AI_PROVIDER empty to disable AI; manual survey editing remains available.
