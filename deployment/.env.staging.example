# Copy to deployment/.env.staging; replace survey-staging.example.com with your domain.
DATABASE_NAME=survey_staging
DATABASE_USER=survey
DATABASE_PASSWORD=
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=survey-staging.example.com,localhost,127.0.0.1,api
CORS_ORIGINS=https://survey-staging.example.com
CSRF_TRUSTED_ORIGINS=https://survey-staging.example.com
SURVEY_WEB_URL=https://survey-staging.example.com
# Blank compiles same-origin browser requests; build again after changing it.
NEXT_PUBLIC_API_URL=
DOMAIN=survey-staging.example.com
ACME_EMAIL=
RELEASE_TAG=staging-001
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=true

