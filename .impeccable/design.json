      "html": "<section class=\"ds-preview\"><h3>Answer preview</h3><div class=\"ds-choices\" role=\"group\" aria-label=\"Recommendation score\"><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>0</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>1</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>2</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>3</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>4</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>5</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>6</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>7</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>8</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>9</span></label><label class=\"ds-choice\"><input type=\"radio\" name=\"ds-nps\"/><span>10</span></label></div></section>",
      "css": ".ds-preview{font-family:Vazirmatn,Tahoma,sans-serif;background:#faf5ec;border:1px solid #e5d6df;border-radius:12px;padding:20px;color:#322039}.ds-preview h3{font-size:14px;color:#77597b;margin:0 0 12px}.ds-choices{display:flex;flex-wrap:wrap;gap:12px}.ds-choice{position:relative;min-width:44px;text-align:center;border:1px solid #d9cbdc;border-radius:8px;padding:12px;background:white;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-choice input{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.ds-choice:has(input:checked){background:#f3e8ff;border-color:#7e22ce}.ds-choice:focus-within{outline:2px solid #9333ea;outline-offset:0}"
