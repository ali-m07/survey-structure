# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ex_platform_db
DATABASE_NAME=ex_platform_db
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Kafka Configuration (Optional)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@example.com

# Tenant Configuration
DEFAULT_TENANT_ID=default
MULTI_TENANT_ENABLED=True

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
OLLAMA_API_URL=http://localhost:11434

# n8n Configuration
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Authentication & Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_HOSTS=localhost,127.0.0.1,*.example.com

# OAuth2 / SSO
OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# SAML Configuration
SAML_ENTITY_ID=your-saml-entity-id
SAML_SSO_URL=https://your-idp.com/sso
SAML_X509_CERT=your-saml-certificate

# LDAP / Active Directory
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password

# Monitoring
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3001
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
LOKI_URL=http://localhost:3100

# Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token
VAULT_NAMESPACE=

# Blockchain (Ethereum)
ETHEREUM_RPC_URL=http://localhost:8545
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key
CONTRACT_ADDRESS=your-contract-address

# Third-party Integrations
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

WORKDAY_WSDL_URL=https://your-workday-instance.com/ccx/service/customreport2
WORKDAY_USERNAME=your-workday-username
WORKDAY_PASSWORD=your-workday-password

BAMBOO_HR_API_KEY=your-bamboo-hr-api-key
BAMBOO_HR_SUBDOMAIN=your-subdomain

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Application Settings
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL
FRONTEND_URL=http://localhost:3000

# API Gateway
API_GATEWAY_URL=http://localhost:8080
TRAEFIK_API_DASHBOARD=True
TRAEFIK_API_PORT=8080

